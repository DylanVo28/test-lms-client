{
  "rewrites": [
    {
      "source": "/:locale(en|vi|zh-CN)/:path*",
      "destination": "/:path*?locale=:locale"
    },
    {
      "source": "/:locale(en|vi|zh-CN)",
      "destination": "/?locale=:locale"
    }
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "/en",
      "permanent": false
    }
  ],
  "functions": {
    "src/pages/**/*.tsx": {
      "maxDuration": 30
    }
  },
  "routes": [
    {
      "src": "/vi/(.*)",
      "dest": "/$1?locale=vi"
    },
    {
      "src": "/zh-CN/(.*)",
      "dest": "/$1?locale=zh-CN"
    },
    {
      "src": "/en/(.*)",
      "dest": "/$1?locale=en"
    }
  ]
}