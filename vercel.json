{
  "functions": {
    "src/pages/**/*.tsx": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/:locale(en|vi|zh-CN)/:path*",
      "destination": "/:path*?locale=:locale"
    },
    {
      "source": "/:locale(en|vi|zh-CN)",
      "destination": "/?locale=:locale"
    },
    {
      "source": "/((?!api|_next/static|_next/image|favicon.ico|locales).*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "/en",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Accept-Language",
          "value": "en,vi,zh-CN"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/locales/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "installCommand": "npm install"
}
