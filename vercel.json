{
  "functions": {
    "src/pages/**/*.tsx": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/locales/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/locales/:locale/:namespace.json",
      "destination": "/locales/:locale/:namespace.json"
    }
  ],
  "build": {
    "env": {
      "NEXT_PUBLIC_I18N_DEBUG": "false"
    }
  }
}
